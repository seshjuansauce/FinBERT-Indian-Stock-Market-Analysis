{
  // TCS volatility tracker — Worker + daily container + R2. Deploy: see README.md in this folder.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finbert-vol",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "assets": { "directory": "./public", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "finbert-vol" }],

  // Mon–Fri 17:40 UTC = 23:10 IST: after the close and the evening news, before the next open
  "triggers": { "crons": ["40 17 * * 1-5"] },

  "containers": [{
    "class_name": "Runner",
    "image": "../Dockerfile.live",
    "image_build_context": "..",
    "instance_type": "standard-1",          // 1/2 vCPU, 4 GiB, 8 GB disk — FinBERT on CPU needs ~1.5 GiB
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "RUNNER", "class_name": "Runner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Runner"] }]
}
